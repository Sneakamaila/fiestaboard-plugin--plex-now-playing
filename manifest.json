{
  "id": "plex_now_playing",
  "name": "Plex Now Playing",
  "version": "1.2.0",
  "description": "Displays current Plex playback with smart line wrapping and optional Plex-yellow accents on Vestaboard Note.",
  "author": "Sneakamaila",
  "icon": "film",
  "category": "entertainment",
  "repository": "https://github.com/Sneakamaila/fiestaboard-plugin--plex-now-playing",
  "settings_schema": {
    "type": "object",
    "properties": {
      "plex_url": {
        "type": "string",
        "title": "Plex Server URL",
        "description": "Base URL of your Plex Media Server (e.g. http://192.168.1.50:32400)",
        "default": "http://192.168.1.50:32400"
      },
      "plex_token": {
        "type": "string",
        "title": "Plex X-Token",
        "description": "Your personal Plex authentication token",
        "ui:widget": "password"
      },
      "target_user": {
        "type": "string",
        "title": "Target User (optional)",
        "description": "Only show streams from this Plex user. Leave empty to show all users."
      },
      "show_yellow_accents": {
        "type": "boolean",
        "title": "Show Plex yellow accents",
        "description": "Display two yellow tiles on each side of the year (movies) or season/episode (series).",
        "default": true
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "default": 30,
        "minimum": 10,
        "maximum": 600
      }
    },
    "required": ["plex_url", "plex_token"]
  },
  "variables": {
    "simple": [
      "is_playing",
      "media_type",
      "line1",
      "line2",
      "line3",
      "title",
      "year",
      "show_name",
      "season_episode",
      "episode_title",
      "user",
      "status"
    ]
  },
  "max_lengths": {
    "is_playing": 3,
    "media_type": 7,
    "line1": 15,
    "line2": 15,
    "line3": 15,
    "title": 15,
    "year": 6,
    "show_name": 15,
    "season_episode": 8,
    "episode_title": 15,
    "user": 15,
    "status": 15
  },
  "teaser": "BREAKING BAD",
  "previews": [
    {
      "label": "Series (Note)",
      "device_type": "note",
      "rows": [
        "  BREAKING BAD ",
        "    S05 E14    ",
        "   OZYMANDIAS  "
      ]
    },
    {
      "label": "Movie (Note)",
      "device_type": "note",
      "rows": [
        " INTERSTELLAR  ",
        "               ",
        "     2014      "
      ]
    }
  ]
}
